{
  "name": "react-native-lunar-calendars",
  "version": "3.0.1",
  "description": "React Native calendar components with Vietnamese lunar calendar (Âm Lịch) support. Works with bare React Native and Expo. Fork of react-native-calendars.",
  "homepage": "https://github.com/Ky0-Nguyen/react-native-lunar-calendars#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "README.vi.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "expo",
    "calendar",
    "lunar",
    "lunar-calendar",
    "vietnamese",
    "am-lich",
    "amlich",
    "react-native-calendar",
    "agenda",
    "typescript"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ky0-Nguyen/react-native-lunar-calendars.git"
  },
  "bugs": {
    "url": "https://github.com/Ky0-Nguyen/react-native-lunar-calendars/issues"
  },
  "upstream": {
    "repository": "https://github.com/wix/react-native-calendars",
    "version": "1.x"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "Tuan Nguyen <ky0.nguyen@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "lodash.get": "^4.4.2",
    "lodash.isequal": "^4.5.0",
    "xdate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.64.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/react": "^19.2.0",
    "@types/xdate": "^0.8.35",
    "babel-jest": "^29.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "rimraf": "^6.0.1",
    "test-renderer": "^1.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  }
}
